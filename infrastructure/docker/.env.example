# Copy this file to .env for local use. The real .env is Git-ignored.

# Host port for the local n8n UI. Keep container port 5678 unchanged.
N8N_HOST_PORT=5678

# Local development settings.
N8N_HOST=localhost
N8N_SECURE_COOKIE=false

# Replace locally with a long random value. Never commit or share the real key.
# Keep the same local value across restarts so stored credentials remain usable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-local-development-key

# Thesis runtime timezone.
GENERIC_TIMEZONE=Europe/Stockholm
TZ=Europe/Stockholm

# Keep the local baseline quiet and reproducible.
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
